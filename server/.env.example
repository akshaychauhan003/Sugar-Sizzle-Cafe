# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
# MongoDB Atlas or local. Database name is the path segment after the host
# (e.g. .../restoflow). Optional MONGODB_DB_NAME is not read by the app —
# put the db name in the URI itself.
MONGODB_URI=mongodb://127.0.0.1:27017/restoflow
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Default tax % used until an admin sets one in Settings
DEFAULT_TAX_RATE=5
# Max discount % a Staff/Cashier user may apply (Admin / Shift Manager unlimited)
STAFF_MAX_DISCOUNT_PERCENT=10
# Reporting day boundaries: offset from UTC in minutes (330 = IST)
REPORT_TZ_OFFSET_MINUTES=330
# Seed script refuses to run when NODE_ENV=production unless this is "true"
SEED_ALLOW_PRODUCTION=false
