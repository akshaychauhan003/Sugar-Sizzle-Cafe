{
  "name": "sugar-and-sizzle-pos",
  "version": "1.0.0",
  "description": "Sugar & Sizzle — Hot Honey & Chili Co. Cafe POS & Order Management System",
  "private": true,
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/start.sh",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build": "cd frontend && npm run build",
    "seed": "cd backend && npm run seed",
    "seed:database": "node database/seeds/seed.js",
    "test": "cd backend && MONGODB_URI_TEST=mongodb://127.0.0.1:27017/restoflow_test npm test",
    "test:backend": "cd backend && MONGODB_URI_TEST=mongodb://127.0.0.1:27017/restoflow_test npm test",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "dev:server": "npm run dev:backend",
    "dev:web": "npm run dev:frontend",
    "build:web": "npm run build:frontend",
    "test:server": "npm run test:backend"
  },
  "devDependencies": {}
}
